# Copy to .env and edit. Never commit the real .env.
# A long random shared secret. Generate one with:  openssl rand -hex 24
STT_TOKEN=change-me-to-a-long-random-string
# Whisper model: base (light, ~150MB), small (recommended for Russian, ~470MB),
# medium (best quality, heavier ~1.5GB RAM).
WHISPER_MODEL=small
# The VM's LAN IP the gateway listens on (find with: ip -4 addr).
# Use 127.0.0.1 for local-only testing; set your LAN IP to let the device reach it.
BIND_IP=192.168.1.50
